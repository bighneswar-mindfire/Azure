PORT=4000

AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=clinical-documents

DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/your-database?sslmode=require

# The Azure Function that owns OCR/extraction/business-rules/confidence
# scoring (see ../function). Defaults to the local Functions host if unset.
PROCESSING_FUNCTION_URL=http://localhost:7071/api
PROCESSING_FUNCTION_KEY=
