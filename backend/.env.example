PORT=4000

# Azure Storage connection string. For local development, run the Azurite
# emulator and use its well-known connection string:
# npm install -g azurite && azurite
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=clinical-documents

# Azure Database for PostgreSQL flexible server connection string.
DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/your-database?sslmode=require
